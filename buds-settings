#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
TMP_RUNNER="$(mktemp --suffix=.js)"
trap 'rm -f "$TMP_RUNNER"' EXIT

cat > "$TMP_RUNNER" <<EOF
import Adw from 'gi://Adw?version=1';
import Gio from 'gi://Gio';
import { populatePreferencesWindow } from 'file://${SCRIPT_DIR}/budsSettingsWindow.js';

Adw.init();
const app = new Adw.Application({
    application_id: 'io.github.pulkitmundra.GalaxyBudsSwitcher.Settings',
    flags: Gio.ApplicationFlags.NON_UNIQUE,
});
app.connect('activate', application => {
    const win = new Adw.PreferencesWindow({ application });
    populatePreferencesWindow(win);
    win.present();
});
app.run([]);
EOF

gjs -m "$TMP_RUNNER" "$@"
