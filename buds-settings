#!/usr/bin/env bash
set -euo pipefail

EXT_UUID="galaxy-buds-switcher@pulkitmundra.github.io"
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

sync_gsettings_to_env() {
  local mac=""
  local hook=""
  if command -v gsettings >/dev/null 2>&1 && [ -d "$SCRIPT_DIR/schemas" ]; then
    mac="$(gsettings --schemadir "$SCRIPT_DIR/schemas" get org.gnome.shell.extensions.galaxy-buds-switcher bud-mac 2>/dev/null | sed -E "s/^'//; s/'$//" || true)"
    hook="$(gsettings --schemadir "$SCRIPT_DIR/schemas" get org.gnome.shell.extensions.galaxy-buds-switcher macrodroid-webhook 2>/dev/null | sed -E "s/^'//; s/'$//" || true)"
  elif command -v dconf >/dev/null 2>&1; then
    mac="$(dconf read /org/gnome/shell/extensions/galaxy-buds-switcher/bud-mac 2>/dev/null | sed -E "s/^'//; s/'$//" || true)"
    hook="$(dconf read /org/gnome/shell/extensions/galaxy-buds-switcher/macrodroid-webhook 2>/dev/null | sed -E "s/^'//; s/'$//" || true)"
  fi
  hook="${hook%/}"
  hook="${hook%/buds}"

  mkdir -p "$HOME/.config"
  cat > "$SCRIPT_DIR/.env" <<ENVEOF
# Galaxy Buds3 Pro Bluetooth MAC Address (check via \`bluetoothctl devices\`)
BUD_MAC="${mac}"

# MacroDroid Webhook Base URL (without trailing /buds)
MACRODROID_WEBHOOK_BASE="${hook}"
ENVEOF
  chmod 600 "$SCRIPT_DIR/.env" 2>/dev/null || true
  if [ ! -e "$HOME/.config/buds-switch.env" ]; then
    ln -sf "$SCRIPT_DIR/.env" "$HOME/.config/buds-switch.env"
  elif [ "$(readlink -f "$HOME/.config/buds-switch.env")" != "$(readlink -f "$SCRIPT_DIR/.env")" ]; then
    cp -f "$SCRIPT_DIR/.env" "$HOME/.config/buds-switch.env"
    chmod 600 "$HOME/.config/buds-switch.env" 2>/dev/null || true
  fi
}

if gnome-extensions info "$EXT_UUID" >/dev/null 2>&1; then
  gnome-extensions prefs "$EXT_UUID" "$@"
  sync_gsettings_to_env
  exit 0
fi

TMP_RUNNER="$(mktemp --suffix=.js)"
trap 'rm -f "$TMP_RUNNER"; sync_gsettings_to_env' EXIT

sed "s|import {ExtensionPreferences} from 'resource:///org/gnome/Shell/Extensions/js/extensions/prefs.js';|class ExtensionPreferences { getSettings() { const src = Gio.SettingsSchemaSource.new_from_directory('${SCRIPT_DIR}/schemas', Gio.SettingsSchemaSource.get_default(), false); return new Gio.Settings({ settings_schema: src.lookup('org.gnome.shell.extensions.galaxy-buds-switcher', true) }); } }|" \
  "$SCRIPT_DIR/prefs.js" > "$TMP_RUNNER"

cat >> "$TMP_RUNNER" <<EOF

Adw.init();
const app = new Adw.Application({
    application_id: 'io.github.pulkitmundra.GalaxyBudsSwitcher.Settings',
    flags: Gio.ApplicationFlags.NON_UNIQUE,
});
app.connect('activate', application => {
    const win = new Adw.PreferencesWindow({application});
    const prefs = new BudsQuickTogglePreferences();
    const settings = prefs.getSettings();
    const syncEnv = () => {
        try {
            const mac = settings.get_string('bud-mac').trim();
            const hook = settings.get_string('macrodroid-webhook').trim().replace(/\\/+$/, '').replace(/\\/buds$/i, '');
            const content =
                '# Galaxy Buds3 Pro Bluetooth MAC Address (check via bluetoothctl devices)\\n' +
                'BUD_MAC="' + mac + '"\\n\\n' +
                '# MacroDroid Webhook Base URL (without trailing /buds)\\n' +
                'MACRODROID_WEBHOOK_BASE="' + hook + '"\\n';
            GLib.file_set_contents('${SCRIPT_DIR}/.env', content);
        } catch (_e) {}
    };
    settings.connect('changed', syncEnv);
    syncEnv();
    prefs.fillPreferencesWindow(win);
    win.present();
});
app.run([]);
EOF

GSETTINGS_SCHEMA_DIR="$SCRIPT_DIR/schemas" gjs -m "$TMP_RUNNER" "$@"
