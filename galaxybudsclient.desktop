[Desktop Entry]
Name=Galaxy Buds Manager
Comment=Manage Samsung Galaxy Buds (ANC, Ambient, Battery, Equalizer, Touch Controls)
Exec=__HOME__/.local/opt/galaxybudsclient/GalaxyBudsClient
Terminal=false
Type=Application
Icon=__HOME__/.local/share/icons/earbuds-symbolic.svg
Categories=AudioVideo;Audio;Settings;
