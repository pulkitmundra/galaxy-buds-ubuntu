# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Your Galaxy Buds Bluetooth MAC Address (find with: bluetoothctl devices)
BUD_MAC="AA:BB:CC:DD:EE:FF"

# Your Android MacroDroid Webhook Base URL (without trailing /buds)
# Leave empty if you only want Ubuntu connect/disconnect without phone webhook pull
MACRODROID_WEBHOOK_BASE="https://trigger.macrodroid.com/YOUR-UUID-HERE"
