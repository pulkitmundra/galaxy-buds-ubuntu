# Copy this file to .env and fill in your values (or run `buds-settings` for the GUI configurator):
#   cp .env.example .env

# Your Samsung Galaxy Buds Bluetooth MAC Address (Buds3 Pro, Buds3, Buds2 Pro, Buds2, Buds Pro, Buds FE, Buds Live, Buds+)
# Leave as AA:BB:CC:DD:EE:FF to auto-detect your paired Galaxy Buds from BlueZ, or click "Auto-Detect Paired Buds" in `buds-settings`
BUD_MAC="AA:BB:CC:DD:EE:FF"

# Your Android MacroDroid Webhook Base URL (without trailing /buds)
# Leave empty if you only want Ubuntu connect/disconnect without phone auto-reconnect webhook
MACRODROID_WEBHOOK_BASE="https://trigger.macrodroid.com/YOUR-UUID-HERE"
